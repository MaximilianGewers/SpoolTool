{% extends 'base.html.twig' %}

{% block title %}Spool index{% endblock %}

{% block body %}
    <div class="flex items-start justify-between mb-6">
        <div>
            <h1 class="text-2xl font-semibold text-gray-900">Spools</h1>
            <p class="text-sm text-gray-600 mt-1">Manage the spools available in your library.</p>
        </div>
        <twig:Button label="Create new" href="{{ path('app_spool_new') }}" variant="primary" />
    </div>

    <div class="bg-white border border-gray-200 rounded-lg shadow-sm">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wide">Id</th>
                    <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wide">Color</th>
                    <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wide">Brand</th>
                    <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wide">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
            {% for spool in spools %}
                <tr class="hover:bg-gray-50">
                    <td class="px-4 py-3 text-sm text-gray-900">{{ spool.id }}</td>
                    <td class="px-4 py-3">
                        <div class="inline-flex items-center gap-3">
                            <span class="inline-block w-5 h-5 rounded-full border border-gray-200 shadow-inner" style="background-color: {{ spool.color }}"></span>
                            <span class="font-mono text-sm text-gray-800">{{ spool.color }}</span>
                        </div>
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-900">
                        {% if spool.spoolBrand %}
                            <span class="inline-flex items-center rounded-md bg-blue-50 px-2 py-1 text-xs font-semibold text-blue-800 border border-blue-100">
                                {{ spool.spoolBrand.name }}
                            </span>
                        {% else %}
                            <span class="text-gray-500 text-sm">Unassigned</span>
                        {% endif %}
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-900">
                        <span class="text-sm text-gray-800">
                        {{ spool.grams }}
                        </span> g
                    </td>
                    <td class="px-4 py-3">
                        <div class="flex items-center gap-2">
                            <twig:Button label="Show" href="{{ path('app_spool_show', {'id': spool.id}) }}" variant="primary" />
                            <twig:Button label="Edit" href="{{ path('app_spool_edit', {'id': spool.id}) }}" variant="secondary" />
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="px-4 py-6 text-center text-sm text-gray-600">No spools found.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
