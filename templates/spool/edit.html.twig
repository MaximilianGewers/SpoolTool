{% extends 'base.html.twig' %}

{% block title %}Edit Spool{% endblock %}

{% block body %}
    <div class="flex items-start justify-between mb-6">
        <div>
            <h1 class="text-2xl font-semibold text-gray-900">Edit spool</h1>
            <p class="text-sm text-gray-600 mt-1">Update the color or details for this spool.</p>
        </div>
        <a href="{{ path('app_spool_index') }}" class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2">
            Back to list
        </a>
    </div>

    <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-6 space-y-6">
        {{ include('spool/_form.html.twig', {'button_label': 'Update'}) }}

        <div class="border-t border-gray-200 pt-4">
            {{ include('spool/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
