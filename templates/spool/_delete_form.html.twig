<form method="post" action="{{ path('app_spool_delete', {'id': spool.id}) }}" class="inline-block" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ spool.id) }}">
    <twig:Button label="Delete" variant="danger" type="submit" />
</form>
