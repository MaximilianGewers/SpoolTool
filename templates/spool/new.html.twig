{% extends 'base.html.twig' %}

{% block title %}New Spool{% endblock %}

{% block body %}
    <div class="flex items-start justify-between mb-6">
        <div>
            <h1 class="text-2xl font-semibold text-gray-900">Create new spool</h1>
            <p class="text-sm text-gray-600 mt-1">Add a new spool color to your collection.</p>
        </div>
        <twig:Button label="Back to list" href="{{ path('app_spool_index') }}" variant="secondary" />
    </div>

    <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-6">
        {{ include('spool/_form.html.twig') }}
    </div>
{% endblock %}
